node_modules/
.DS_Store
.env
.env.*
!.env.example

# Signing material and store keys never enter git (~/works/common holds them)
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
credentials.json
credentials/

# Firebase config (download from Firebase Console into firebase/, never commit)
firebase/GoogleService-Info.plist
firebase/google-services.json

# Build output (Unity Xcode/Gradle projects live in unity/Build, ignored by unity/.gitignore)
build-output/
*.ipa
*.aab
*.apk
fastlane/report.xml

# Fastlane store metadata and screenshots stay in git
!fastlane/metadata/**
!screenshots/**

# Local tool caches
.playwright-mcp/
.codegraph/
.idea/
.vscode/
/*.png

# Agent workspace (inter-agent data exchange). Decisions the next session (or a fresh clone)
# needs are kept: the survey answers, PRD/KPIs and the iterate backlog.
_workspace/*
!_workspace/spec.md
!_workspace/plan/
!_workspace/iterate/
